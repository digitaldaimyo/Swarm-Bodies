    "start:e2e": "tsx scripts/ensure-db.ts && tsx src/main.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/static": "8.2.0",
    "@fastify/websocket": "11.3.4",
    "@swarm/bot": "workspace:*",
    "@swarm/content": "workspace:*",
    "@swarm/protocol": "workspace:*",
    "@swarm/sim": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "postgres": "3.4.9",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "0.31.11",
    "ws": "8.22.0"
  }
